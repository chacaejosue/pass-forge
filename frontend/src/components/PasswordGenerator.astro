<section id="generador" class="surface generator-panel p-5 sm:p-7" aria-labelledby="generator-title">
  <div class="relative z-10 flex flex-col gap-4">
    <div class="control-row generator-heading"><div class="flex items-center gap-3"><span class="icon-box icon-blue" aria-hidden="true"><svg class="generator-icon" viewBox="0 0 24 24" fill="none"><path d="M7 10V7a5 5 0 0 1 10 0v3M5 10h14v10H5z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 15h.01M12 15h.01M15 15h.01" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></span><div><p class="eyebrow mb-1">Generador interactivo</p><h2 id="generator-title" class="m-0 text-xl font-bold">Genera una contraseña segura</h2></div></div><div class="flex gap-2 text-xs font-semibold"><span id="char-badge" class="badge">20 caracteres</span><span id="entropy" class="badge badge-green">— bits</span></div></div>
    <div class="password-output"><div class="min-w-0 flex-1"><output id="password-output" class="password-text" aria-live="polite">Generando una clave segura...</output><p class="mt-1 text-xs text-slate-500">Generada con una fuente criptográficamente segura</p></div><div class="flex gap-2"><button id="copy-button" class="button button-secondary" type="button">Copiar</button><button id="refresh-button" class="icon-button" type="button" aria-label="Generar otra contraseña" title="Generar otra contraseña"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8 8 0 0 0-14.8-3.8L4 9M4 5v4h4M4 13a8 8 0 0 0 14.8 3.8L20 15M20 19v-4h-4"/></svg></button></div></div>
    <div class="strength-block"><div class="control-row mb-1 text-xs"><span id="strength-label" class="font-bold text-teal-700">Fortaleza estimada</span><span id="crack-time" class="font-mono text-slate-500">Calculando...</span></div><div class="meter" aria-label="Indicador de fortaleza"><span id="bar-1"></span><span id="bar-2"></span><span id="bar-3"></span><span id="bar-4"></span></div></div>
    <div class="control-card"><div class="control-row mb-3"><label for="length" class="font-semibold">Longitud</label><div class="number-control"><button id="decrease" type="button" aria-label="Disminuir longitud">−</button><input id="length-number" type="number" min="12" max="64" value="20" aria-label="Longitud" /><button id="increase" type="button" aria-label="Aumentar longitud">+</button></div></div><input id="length" class="range" type="range" min="12" max="64" value="20" aria-label="Longitud de la contraseña" /><div class="mt-1 flex justify-between text-xs text-slate-400"><span>12 mínimo</span><span>32</span><span>48</span><span>64 máximo</span></div></div>
    <div class="check-grid compact-checks"><label class="check-label"><input type="checkbox" data-option="lowercase" checked /> Minúsculas</label><label class="check-label"><input type="checkbox" data-option="uppercase" checked /> Mayúsculas</label><label class="check-label"><input type="checkbox" data-option="digits" checked /> Números</label><label class="check-label"><input type="checkbox" data-option="symbols" checked /> Símbolos</label></div>
    <p id="generator-error" class="hidden rounded-lg bg-red-50 p-3 text-sm text-red-700" role="alert"></p><button id="generate-button" class="button button-primary w-full py-3" type="button">Generar nueva clave</button><a class="storage-cta" href="#guardar">¿Ya la generaste? Aprende cómo guardarla de forma segura</a>
  </div>
</section>

<script>
  const apiUrl = import.meta.env.PUBLIC_API_URL || "/api";
  const $ = <T extends Element>(selector: string) => document.querySelector<T>(selector);
  const output = $<HTMLOutputElement>("#password-output"); const lengthInput = $<HTMLInputElement>("#length"); const lengthNumber = $<HTMLInputElement>("#length-number"); const lengthValue = $<HTMLElement>("#char-badge"); const entropy = $("#entropy"); const error = $("#generator-error"); const generateButton = $<HTMLButtonElement>("#generate-button"); const refreshButton = $<HTMLButtonElement>("#refresh-button"); const copyButton = $<HTMLButtonElement>("#copy-button");
  const setLength = (value: number) => { const safe = Math.max(12, Math.min(64, Number(value) || 20)); if (lengthInput) lengthInput.value = String(safe); if (lengthNumber) lengthNumber.value = String(safe); if (lengthValue) lengthValue.textContent = `${safe} caracteres`; return safe; };
  const updateMeter = (length: number, years?: number) => { const bars = [$("#bar-1"), $("#bar-2"), $("#bar-3"), $("#bar-4")]; const active = length >= 32 ? 4 : length >= 20 ? 3 : length >= 16 ? 2 : 1; bars.forEach((bar, index) => { if (bar) bar.className = index < active ? "active" : ""; }); const crack = $("#crack-time"); if (crack && years !== undefined) crack.textContent = years >= 1e12 ? "Más de 10¹² años estimados" : `${new Intl.NumberFormat("es-ES").format(years)} años estimados`; };
  const generate = async () => { if (!lengthInput || !output || !entropy || !error || !generateButton) return; const length = setLength(Number(lengthInput.value)); updateMeter(length); error.classList.add("hidden"); generateButton.disabled = true; generateButton.textContent = "Generando..."; const options = Object.fromEntries(Array.from(document.querySelectorAll<HTMLInputElement>("[data-option]")).map((input) => [input.dataset.option, input.checked])); try { const response = await fetch(`${apiUrl}/passwords`, { method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify({ length, ...options }) }); const contentType = response.headers.get("content-type") || ""; if (!contentType.includes("application/json")) throw new Error("La API no está disponible. Comprueba que Flask esté ejecutándose."); const data = await response.json(); if (!response.ok) throw new Error(data.error || "No se pudo generar la contraseña."); output.textContent = data.password; entropy.textContent = `${data.entropy} bits estimados`; updateMeter(length, data.estimated_exhaustive_years); } catch (requestError) { error.textContent = requestError instanceof Error ? requestError.message : "Error de conexión con la API."; error.classList.remove("hidden"); } finally { generateButton.disabled = false; generateButton.textContent = "Generar nueva clave"; } };
  lengthInput?.addEventListener("input", () => { setLength(Number(lengthInput.value)); updateMeter(Number(lengthInput.value)); }); lengthNumber?.addEventListener("change", () => { setLength(Number(lengthNumber.value)); generate(); }); $("#decrease")?.addEventListener("click", () => { setLength(Number(lengthInput?.value) - 1); generate(); }); $("#increase")?.addEventListener("click", () => { setLength(Number(lengthInput?.value) + 1); generate(); }); generateButton?.addEventListener("click", generate); refreshButton?.addEventListener("click", generate); copyButton?.addEventListener("click", async () => { if (!output?.textContent || output.textContent.includes("Generando")) return; try { await navigator.clipboard.writeText(output.textContent); copyButton.textContent = "Copiado"; setTimeout(() => { copyButton.textContent = "Copiar"; }, 1500); } catch { copyButton.textContent = "Copia manual"; } }); generate();
</script>
