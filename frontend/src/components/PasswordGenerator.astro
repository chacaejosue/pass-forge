<section id="generador" class="surface generator-panel p-5 sm:p-8" aria-labelledby="generator-title">
  <div class="control-row mb-5"><div><p class="eyebrow mb-2">Generador interactivo</p><h2 id="generator-title" class="m-0 text-xl font-bold">Consola de generación criptográfica</h2></div><span id="entropy" class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-700">— bits</span></div>
  <div class="password-output mb-6"><output id="password-output" class="password-text" aria-live="polite">Generando una clave segura…</output><div class="flex gap-2"><button id="copy-button" class="button button-secondary" type="button">Copiar</button><button id="refresh-button" class="button button-secondary" type="button" aria-label="Generar otra contraseña">↻</button></div></div>
  <div class="mb-5"><div class="control-row mb-2"><label for="length" class="font-semibold">Longitud de la contraseña</label><output id="length-value" class="rounded border border-blue-200 px-3 py-1 text-sm font-bold text-blue-800">20</output></div><input id="length" class="range" type="range" min="12" max="64" value="20" /><div class="mt-1 flex justify-between text-xs text-slate-400"><span>12 caracteres (mínimo seguro)</span><span>64 caracteres</span></div></div>
  <div class="mb-5"><p class="mb-2 font-semibold">Tipos de caracteres</p><div class="check-grid"><label class="check-label"><input type="checkbox" data-option="lowercase" checked /> Minúsculas</label><label class="check-label"><input type="checkbox" data-option="uppercase" checked /> Mayúsculas</label><label class="check-label"><input type="checkbox" data-option="digits" checked /> Números</label><label class="check-label"><input type="checkbox" data-option="symbols" checked /> Símbolos</label></div></div>
  <p id="generator-error" class="mb-4 hidden rounded-lg bg-red-50 p-3 text-sm text-red-700" role="alert"></p><button id="generate-button" class="button button-primary w-full" type="button">⚡ Generar nueva clave</button><p class="mt-3 text-center text-xs text-slate-400">Las contraseñas no se guardan ni se registran.</p>
</section>

<script>
  const apiUrl = import.meta.env.PUBLIC_API_URL || "/api";
  const output = document.querySelector<HTMLOutputElement>("#password-output"); const lengthInput = document.querySelector<HTMLInputElement>("#length"); const lengthValue = document.querySelector<HTMLOutputElement>("#length-value"); const entropy = document.querySelector<HTMLElement>("#entropy"); const error = document.querySelector<HTMLElement>("#generator-error"); const generateButton = document.querySelector<HTMLButtonElement>("#generate-button"); const refreshButton = document.querySelector<HTMLButtonElement>("#refresh-button"); const copyButton = document.querySelector<HTMLButtonElement>("#copy-button");
  const generate = async () => { if (!lengthInput || !output || !entropy || !error || !generateButton) return; error.classList.add("hidden"); generateButton.disabled = true; generateButton.textContent = "Generando…"; const options = Object.fromEntries(Array.from(document.querySelectorAll<HTMLInputElement>("[data-option]")).map((input) => [input.dataset.option, input.checked])); try { const response = await fetch(`${apiUrl}/passwords`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ length: Number(lengthInput.value), ...options }) }); const data = await response.json(); if (!response.ok) throw new Error(data.error || "No se pudo generar la contraseña."); output.textContent = data.password; entropy.textContent = `${data.entropy} bits`; } catch (requestError) { error.textContent = requestError instanceof Error ? requestError.message : "Error de conexión con la API."; error.classList.remove("hidden"); } finally { generateButton.disabled = false; generateButton.textContent = "⚡ Generar nueva clave"; } };
  lengthInput?.addEventListener("input", () => { if (lengthValue && lengthInput) lengthValue.value = lengthInput.value; }); generateButton?.addEventListener("click", generate); refreshButton?.addEventListener("click", generate); copyButton?.addEventListener("click", async () => { if (!output?.textContent || output.textContent.includes("…")) return; await navigator.clipboard.writeText(output.textContent); if (copyButton) { copyButton.textContent = "Copiado"; setTimeout(() => { copyButton.textContent = "Copiar"; }, 1500); } }); generate();
</script>
